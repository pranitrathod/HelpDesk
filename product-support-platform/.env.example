# Copy to .env for local Docker Compose. Values here are development-only.
MYSQL_ROOT_PASSWORD=local_mysql_change_me
JWT_SECRET=local-only-change-this-secret-to-a-random-value-at-least-32-bytes
# For production, set SPRING_PROFILES_ACTIVE=prod and configure Razorpay credentials securely.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
